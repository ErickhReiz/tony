[Unit]
Description=Stack Tony (PostgreSQL e Evolution GO)
Requires=docker.service tony-firewall.service
After=docker.service tony-firewall.service network-online.target
PartOf=docker.service

[Service]
Type=simple
WorkingDirectory=@PROJECT_DIR@
ExecStart=/usr/bin/docker compose up --no-color
ExecStop=/usr/bin/docker compose stop --timeout 30
Restart=always
RestartSec=5
TimeoutStartSec=0
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
