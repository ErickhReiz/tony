[Unit]
Description=Firewall de saída isolada da stack Tony
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
Before=tony-stack.service
PartOf=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=@PROJECT_DIR@
ExecStartPre=/usr/bin/docker compose create postgres evolution-go
ExecStart=/usr/local/libexec/tony-network-firewall apply
ExecReload=/usr/local/libexec/tony-network-firewall apply

[Install]
WantedBy=multi-user.target
