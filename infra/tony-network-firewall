#!/usr/bin/env bash
set -euo pipefail

readonly EGRESS_IF="br-tony-egress"
readonly DOCKER_CHAIN="TONY-DOCKER-EGRESS"
readonly INPUT_CHAIN="TONY-HOST-GUARD"

die() {
  printf 'tony-network-firewall: %s\n' "$*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "comando ausente: $1"
}

ensure_chain() {
  local chain="$1"
  iptables -w -t filter -S "$chain" >/dev/null 2>&1 || iptables -w -t filter -N "$chain"
  iptables -w -t filter -F "$chain"
}

ensure_single_jump_first() {
  local parent="$1" child="$2"
  while iptables -w -t filter -C "$parent" -j "$child" >/dev/null 2>&1; do
    iptables -w -t filter -D "$parent" -j "$child"
  done
  iptables -w -t filter -I "$parent" 1 -j "$child"
}

require_command ip
require_command iptables
require_command docker

[[ "${1:-}" == "apply" ]] || die 'uso: tony-network-firewall apply'
iptables -w -t filter -S DOCKER-USER >/dev/null 2>&1 || die 'DOCKER-USER ainda não existe; Docker precisa estar ativo'
ip link show dev "$EGRESS_IF" >/dev/null 2>&1 || die "interface $EGRESS_IF não existe; crie a rede Compose antes do firewall"

mapfile -t docker_network_ids < <(docker network ls -q)
mapfile -t tony_network_ids < <(docker network ls -q --filter label=com.docker.compose.project=tony)
((${#tony_network_ids[@]} > 0)) || die 'nenhuma rede do projeto Compose tony foi encontrada'

docker_subnets=()
for network_id in "${docker_network_ids[@]}"; do
  while IFS= read -r subnet; do
    [[ -n "$subnet" && "$subnet" != *:* ]] && docker_subnets+=("$subnet")
  done < <(docker network inspect --format '{{range .IPAM.Config}}{{println .Subnet}}{{end}}' "$network_id")
done

tony_subnets=()
for network_id in "${tony_network_ids[@]}"; do
  while IFS= read -r subnet; do
    [[ -n "$subnet" && "$subnet" != *:* ]] && tony_subnets+=("$subnet")
  done < <(docker network inspect --format '{{range .IPAM.Config}}{{println .Subnet}}{{end}}' "$network_id")
done
((${#tony_subnets[@]} > 0)) || die 'as redes Tony não têm subnets IPv4 configurados'

direct_prefixes=()
while IFS= read -r prefix; do
  [[ -n "$prefix" && "$prefix" == */* && "$prefix" != "0.0.0.0/0" ]] && direct_prefixes+=("$prefix")
done < <(ip -4 route show scope link | awk '{print $1}' | sort -u)

ensure_chain "$DOCKER_CHAIN"
iptables -w -t filter -A "$DOCKER_CHAIN" -o "$EGRESS_IF" -m conntrack --ctstate ESTABLISHED,RELATED -j RETURN

blocked_destinations=(
  0.0.0.0/8
  10.0.0.0/8
  100.64.0.0/10
  127.0.0.0/8
  169.254.0.0/16
  172.16.0.0/12
  192.0.0.0/24
  192.0.2.0/24
  192.88.99.0/24
  192.168.0.0/16
  198.18.0.0/15
  198.51.100.0/24
  203.0.113.0/24
  224.0.0.0/4
  240.0.0.0/4
)

for prefix in "${blocked_destinations[@]}" "${direct_prefixes[@]}" "${docker_subnets[@]}"; do
  iptables -w -t filter -A "$DOCKER_CHAIN" -i "$EGRESS_IF" -d "$prefix" -j DROP
done
iptables -w -t filter -A "$DOCKER_CHAIN" -i "$EGRESS_IF" -j RETURN
iptables -w -t filter -A "$DOCKER_CHAIN" -j RETURN
ensure_single_jump_first DOCKER-USER "$DOCKER_CHAIN"

ensure_chain "$INPUT_CHAIN"
iptables -w -t filter -A "$INPUT_CHAIN" -m conntrack --ctstate ESTABLISHED,RELATED -j RETURN
for subnet in "${tony_subnets[@]}"; do
  iptables -w -t filter -A "$INPUT_CHAIN" -s "$subnet" -m conntrack --ctstate NEW -j DROP
done
iptables -w -t filter -A "$INPUT_CHAIN" -j RETURN
ensure_single_jump_first INPUT "$INPUT_CHAIN"

printf 'Regras Tony aplicadas: interface=%s redes=%s destinos-locais=%s\n' \
  "$EGRESS_IF" "${#tony_subnets[@]}" "$((${#blocked_destinations[@]} + ${#direct_prefixes[@]} + ${#docker_subnets[@]}))"
